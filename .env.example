# 复制此文件为 .env，填入实际值
# cp .env.example .env

# ── 服务器配置 ──
PORT=3001

# ── 管理员密码（必填！不设置则服务无法启动） ──
ADMIN_PASSWORD=your_strong_password_here

# ── 跨域配置（生产环境填你的域名，多个用逗号分隔） ──
# 示例：https://www.example.com,https://example.com
# 开发时可以填 * 或留空
CORS_ORIGIN=*

# ── 数据目录（默认 backend/data） ──
DATA_DIR=./backend/data

# ── 上传目录（默认 backend/uploads） ──
UPLOAD_DIR=./backend/uploads
