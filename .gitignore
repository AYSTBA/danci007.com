# Dependencies (不要上传到服务器，用 npm install 安装)
node_modules/
backend/node_modules/

# Build outputs (服务器上重新构建)
dist/
build/
out/

# Database files (保留空目录结构，不提交数据库文件)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
!backend/data/.gitkeep

# Uploaded files (用户上传的文件，不要提交)
backend/uploads/
!backend/uploads/.gitkeep

# IDE files
.vscode/
.idea/
*.swp
*.swo
.workbuddy/

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
server.log
server.err
pm2.log*

# Environment variables
.env
.env.local
.env.*.local

# 压缩包和临时文件
*.zip
*.tar.gz
*.tar
*.tmp
*.bak
*.backup
.workbuddy/

# TypeScript 编译输出
dist-ssr/
*.js.map
*.d.ts.map

# Vite 缓存
.vite/

# 本地开发启动脚本（可选，建议保留）
# start-server-80.bat
# start-server-80.ps1

# 测试覆盖率
coverage/
.nyc_output/

# 微信小程序（独立项目，可选）
# miniprogram/

# 文档生成（如果有）
docs/api/

