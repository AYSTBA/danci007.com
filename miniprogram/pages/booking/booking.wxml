<view class="booking-page">
  <!-- 加载 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- Hero -->
    <view class="hero-section">
      <text class="hero-title">联系我们</text>
      <text class="hero-subtitle">预约一节体验课，开启英语提升之旅</text>
    </view>

    <!-- 快捷联系 -->
    <view class="section">
      <view class="contact-grid">
        <view class="contact-card" bindtap="makeCall">
          <text class="contact-icon">📱</text>
          <text class="contact-label">电话</text>
          <text class="contact-val">{{pageContents.contact_phone || '18938908657'}}</text>
        </view>
        <view class="contact-card" bindtap="toggleQR" wx:if="{{pageContents.wechat_qrcode}}">
          <text class="contact-icon">💬</text>
          <text class="contact-label">微信</text>
          <text class="contact-val hint">查看二维码</text>
        </view>
        <view class="contact-card" wx:else>
          <text class="contact-icon">💬</text>
          <text class="contact-label">微信</text>
          <text class="contact-val">敬请期待</text>
        </view>
        <view class="contact-card" bindtap="makeCall">
          <text class="contact-icon">✉️</text>
          <text class="contact-label">邮箱</text>
          <text class="contact-val">{{pageContents.contact_email || 'contact@zhongxuan.com'}}</text>
        </view>
        <view class="contact-card">
          <text class="contact-icon">📍</text>
          <text class="contact-label">地址</text>
          <text class="contact-val small">{{pageContents.contact_address || '深圳市龙岗区'}}</text>
        </view>
      </view>
    </view>

    <!-- 预约表单 -->
    <view class="section">
      <view class="form-header">
        <text class="form-title">预约体验课</text>
        <text class="form-desc">填写信息，我们会在24小时内联系您</text>
      </view>

      <!-- 未提交 -->
      <view class="form-card" wx:if="{{!isSubmitted}}">
        <view class="field">
          <text class="label">姓名 <text class="req">*</text></text>
          <input class="input" placeholder="请输入您的姓名" value="{{form.name}}" bindinput="onNameInput" />
        </view>
        <view class="field">
          <text class="label">手机号 <text class="req">*</text></text>
          <input class="input" type="number" placeholder="请输入手机号码" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="11" />
        </view>
        <view class="field">
          <text class="label">邮箱</text>
          <input class="input" placeholder="请输入邮箱地址" value="{{form.email}}" bindinput="onEmailInput" />
        </view>
        <view class="field-row">
          <view class="field half">
            <text class="label">预约日期 <text class="req">*</text></text>
            <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
              <view class="input picker-val">{{form.date || '选择日期'}}</view>
            </picker>
          </view>
          <view class="field half">
            <text class="label">预约时间 <text class="req">*</text></text>
            <picker range="{{timeOptions}}" value="{{form.time}}" bindchange="onTimeChange" disabled="{{timeOptions.length === 0}}">
              <view class="input picker-val {{timeOptions.length === 0 ? 'disabled' : ''}}">{{form.time || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <text class="label">课程类型 <text class="req">*</text></text>
          <picker range="{{courseOptions}}" value="{{form.course}}" bindchange="onCourseChange">
            <view class="input picker-val">{{form.course || '选择课程'}}</view>
          </picker>
        </view>
        <view class="field">
          <text class="label">留言（选填）</text>
          <textarea class="input textarea" placeholder="告诉我们您的需求..." value="{{form.message}}" bindinput="onMessageInput" />
        </view>
        <view class="submit-btn" bindtap="handleSubmit">提交预约</view>
      </view>

      <!-- 已提交 -->
      <view class="success-card" wx:else>
        <text class="success-icon">✅</text>
        <text class="success-title">预约成功！</text>
        <text class="success-desc">我们会尽快与您联系，请保持电话畅通。</text>
        <view class="success-actions">
          <view class="btn-primary" bindtap="goHome">返回首页</view>
          <view class="btn-outline" bindtap="resetForm">再预约一次</view>
        </view>
      </view>
    </view>

    <!-- 营业时间 -->
    <view class="section">
      <view class="hours-card">
        <text class="hours-title">🕐 营业时间</text>
        <view class="hours-row">
          <text>周一至周五</text>
          <text class="hours-val">{{pageContents.business_hours_weekday || '9:00 - 21:00'}}</text>
        </view>
        <view class="hours-row">
          <text>周六至周日</text>
          <text class="hours-val">{{pageContents.business_hours_weekend || '10:00 - 18:00'}}</text>
        </view>
      </view>
    </view>

    <!-- 页脚 -->
    <view class="page-footer">
      <text class="footer-copy">© 2024 中萱文化 龙岗教学点</text>
    </view>
  </block>

  <!-- 微信二维码弹窗 -->
  <view class="modal-overlay" wx:if="{{showWechatQR && pageContents.wechat_qrcode}}" bindtap="toggleQR">
    <view class="modal" catchtap="">
      <text class="modal-close" bindtap="toggleQR">×</text>
      <text class="modal-title">扫码添加微信</text>
      <image class="modal-qr" src="{{pageContents.wechat_qrcode}}" mode="widthFix" />
    </view>
  </view>
</view>
